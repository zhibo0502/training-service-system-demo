{
  "name": "training-service-system-demo",
  "version": "0.1.0",
  "private": true,
  "description": "培训-客服系统demo：基于 TypeScript 的离线客户问答与客服系统最小可行架构",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ts-qa/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "synth-data": "node ./scripts/synth-and-train.ts",
    "eval-compare": "node ./scripts/eval-synth-vs-small.ts",
    "build-bayes-data": "node ./scripts/build-bayes-corpus.ts",
    "build-hybrid-gold": "node ./scripts/build-hybrid-gold.ts",
    "verify-fsm": "node ./scripts/verify-state-machines.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
